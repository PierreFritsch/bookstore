{
  "name": "@capire/bookstore",
  "version": "2.0.1",
  "description": "Shows how to reuse and compose with CAP.",
  "repository": "https://github.com/capire/bookstore",
  "dependencies": {
    "@cap-js/hana": "2.8.0",
    "@capire/bookshop": "*",
    "@capire/common": "*",
    "@capire/data-viewer": "*",
    "@capire/orders": "*",
    "@sap/cds": "9.9.1",
    "@sap/cds-dk": "9.9.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": ">=0.4.1",
    "@cap-js/sqlite": "^1.11.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "chest": "chest",
    "jest": "jest",
    "test": "chest"
  },
  "cds": {
    "requires": {
      "OrdersService": "odata",
      "db": {
        "[development]": {
          "model": "db/sqlite"
        },
        "[production]": {
          "model": "db/hana"
        }
      }
    },
    "log": {
      "service": true
    }
  }
}
